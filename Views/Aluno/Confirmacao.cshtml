@model Aluno
<div style="background:#d4edda; padding:20px; border-radius:8px;">
    <h2 style="color:green">✅ Aluno cadastrado com sucesso!</h2>
    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>RA:</strong> @Model.RA</p>
    <p><strong>Curso:</strong> @Model.Curso</p>
    <p><strong>Nascimento:</strong> @Model.DataNascimento.ToShortDateString()</p>
</div>
<br/>
<a href="/Aluno/Cadastrar">Cadastrar outro</a>
